# Copy to .env and edit. Never commit .env.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_db_user:your_password_user@localhost:5432/boardtrack_db
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Automatic setup on `npm start` (default true; set to false to disable)
# Create the database in DATABASE_URL if it does not exist (needs CREATEDB privilege)
AUTO_CREATE_DB=true
# Create tables, constraints, trigger function and view if missing
AUTO_SETUP=true
# Load sample data + demo accounts, only when the database is empty
AUTO_SEED=true
